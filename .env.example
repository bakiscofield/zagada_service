# =========================================================
# ZAGADA SERVICE — environnement
# Copie ce fichier vers .env et remplis les valeurs réelles.
# =========================================================

# -- Django --
DEBUG=False
SECRET_KEY=change-me-to-a-50-char-random-string
# Domaines qui hébergent ce backend, séparés par des virgules
ALLOWED_HOSTS=zagbot.warizone.com,localhost,127.0.0.1
# Fuseau horaire des dates affichées dans le bot et l'admin
TIME_ZONE=Africa/Lome

# -- Base de données --
# Vide = SQLite local (db.sqlite3). Prod : postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# -- Bot Telegram (@BotFather) --
TELEGRAM_BOT_TOKEN=
# Secret protégeant le webhook : dans le chemin de l'URL ET dans l'en-tête
# X-Telegram-Bot-Api-Secret-Token. Générez : `openssl rand -hex 32`.
# Vide = webhook refusé (bot désactivé).
TELEGRAM_WEBHOOK_SECRET=
# URL publique de base de l'API, pour `manage.py set_telegram_webhook`.
TELEGRAM_WEBHOOK_BASE_URL=https://zagbot.warizone.com
# URL publique de l'admin Django, mise dans les alertes envoyées à l'équipe.
# Vide = pas de lien dans les alertes.
ADMIN_BASE_URL=https://zagbot.warizone.com
